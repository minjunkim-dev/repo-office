{
 "runner": [
  "claude",
  "--setting-sources",
  "project",
  "--permission-mode",
  "dontAsk",
  "--add-dir",
  "{baseline}",
  "--add-dir",
  "{office}"
 ],
 "allow": [
  "Bash",
  "Read",
  "Edit",
  "Write",
  "Glob",
  "Grep",
  "Agent",
  "Skill",
  "TodoWrite",
  "WebFetch",
  "WebSearch"
 ],
 "deny": [
  "Bash(git push*)",
  "Bash(git * push*)",
  "Bash(gh pr merge*)",
  "Bash(gh pr edit*)",
  "Bash(gh api *-X*)",
  "Bash(gh api *--method*)",
  "Bash(gh api -f*)",
  "Bash(gh api -F*)",
  "Bash(gh api * -f*)",
  "Bash(gh api * -F*)",
  "Bash(gh api *--field*)",
  "Bash(gh api *--raw-field*)",
  "Bash(gh api *--input*)",
  "Bash(gh api *merge*)"
 ],
 "flow": [
  {
   "id": "design",
   "by": "claude",
   "session": "work",
   "prompt": "prompts/design.md",
   "out": "design.md",
   "model": "opus"
  },
  {
   "id": "approve",
   "by": "human",
   "approve": "design.md"
  },
  {
   "id": "implement",
   "by": "claude",
   "session": "work",
   "prompt": "prompts/implement.md",
   "out": "implement.md",
   "model": "difficulty"
  },
  {
   "id": "check",
   "by": "script",
   "out": "check.md",
   "retry": "implement"
  },
  {
   "id": "draft",
   "by": "script",
   "body": "pr-body.md",
   "easy": "design.md",
   "out": "pr.txt"
  },
  {
   "id": "ready",
   "by": "script",
   "ready": "pr.txt",
   "request": "@coderabbitai review"
  },
  {
   "id": "review",
   "by": "claude",
   "session": "review",
   "prompt": "prompts/review.md",
   "out": "review.md",
   "model": "door"
  },
  {
   "id": "post",
   "by": "script",
   "edit": "review-body.md"
  }
 ]
}
